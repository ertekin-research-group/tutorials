# Silicon STATIC calculation -- convergence testing template
#
# The placeholder {ENCUT} is substituted by sweep.py. Do not edit it by hand.
#
# Note what is NOT here: no NSW, no IBRION, no ISIF. This is a static
# calculation on a FIXED structure. That is the whole point -- we are
# isolating the effect of the numerical parameters, so nothing about the
# structure is allowed to change underneath us.
SYSTEM = Si convergence test

# --- accuracy ---
PREC   = Accurate
ENCUT  = {ENCUT}
LREAL  = .FALSE.
LASPH  = .TRUE.

# --- electronic ---
EDIFF  = 1E-6          # SCF noise well below the meV-scale effect we study
NELM   = 100
ALGO   = Normal
ISPIN  = 1

# --- smearing (semiconductor) ---
ISMEAR = 0
SIGMA  = 0.05

# --- static: no ionic motion ---
NSW    = 0
IBRION = -1


# --- I/O: write nothing large, we are running many of these ---
LWAVE  = .FALSE.
LCHARG = .FALSE.
